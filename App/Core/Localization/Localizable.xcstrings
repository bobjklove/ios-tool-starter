    "sample.width": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width: %.0f mm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度：%.0f 毫米"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅：%.0f mm"
          }
        }
      }
    },
    "sample.height": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height: %.0f mm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度：%.0f 毫米"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ：%.0f mm"
          }
        }
      }
