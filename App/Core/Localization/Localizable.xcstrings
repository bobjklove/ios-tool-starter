{
  "sourceLanguage": "en",
  "strings": {
    "app.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ToolStarter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具模板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールテンプレート"
          }
        }
      }
    },
    "action.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "sample.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選択"
          }
        }
      }
    },
    "sample.change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换图片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を変更"
          }
        }
      }
    },
    "sample.emptyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photo yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有图片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真がありません"
          }
        }
      }
    },
    "sample.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo to export an actual-size PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一张照片，按真实尺寸导出 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選ぶと原寸PDFを作成できます。"
          }
        }
      }
    },
    "sample.section.size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ"
          }
        }
      }
    },
    "sample.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual-size PDF preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原尺寸 PDF 预览"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原寸PDFプレビュー"
          }
        }
      }
    },
    "sample.paper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paper"
