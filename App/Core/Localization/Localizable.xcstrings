    "sample.cropNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo fills the selected size with a centered crop. Print at 100% scale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片居中裁切以填满指定尺寸；打印请选择实际大小（100%）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は指定サイズに合わせて中央で切り抜きます。100%で印刷してください。"
          }
        }
      }
    },
    "sample.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export PDF"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 PDF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを書き出す"
          }
        }
      }
    },
    "sample.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存草稿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを保存"
          }
        }
      }
    },
    "sample.restoreDraft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复草稿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを復元"
          }
        }
      }
    },
    "sample.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo to create an actual-size PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张照片，生成原尺寸 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選ぶと原寸PDFを作成できます。"
          }
        }
      }
    },
    "sample.remaining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d free exports remaining"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %d 次免费导出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の書き出し：残り%d回"
          }
        }
      }
    },
    "sample.saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft saved on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存在本机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きをこの端末に保存しました。"
          }
        }
      }
    },
    "sample.exported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF shared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 已分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを共有しました。"
          }
        }
      }
    },
    "error.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to import this photo. Choose another image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入照片，请换一张重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込めません。別の画像を選んでください。"
          }
        }
      }
    },
    "error.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to export. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しに失敗しました。もう一度お試しください。"
          }
        }
      }
    },
    "error.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read or save this draft. The original file is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿读取或保存失败，原文件已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを読み込み・保存できません。元のファイルは保持されています。"
          }
        }
      }
    },
    "error.quota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free export history is unavailable. Please try again or restore your purchase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费导出记录不可用，请重试或恢复购买。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料書き出し履歴を利用できません。再試行するか購入を復元してください。"
          }
        }
      }
    },
    "purchase.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock full access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁完整版"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全版を購入"
          }
        }
      }
    },
    "purchase.benefit.unlimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited exports"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限次导出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限に書き出し"
          }
        }
      }
    },
    "purchase.benefit.oneTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay once, use forever"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断，永久使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りでずっと使える"
          }
        }
      }
    },
    "purchase.benefit.private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部在本机处理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこの端末で処理"
          }
        }
      }
    },
    "purchase.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited PDF exports. One purchase, no subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限次导出 PDF，一次买断，无订阅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを無制限に書き出せます。買い切りで定期購入はありません。"
          }
        }
      }
    },
    "purchase.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry loading product"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载商品"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品を再読み込み"
          }
        }
      }
