    "purchase.buy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buy once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入する"
          }
        }
      }
    },
    "purchase.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore purchases"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复购买"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "purchase.terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is handled by Apple. Restore with the same Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款由 Apple 处理，请用同一 Apple 账户恢复购买。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはAppleが処理します。同じApple Accountで購入を復元してください。"
          }
        }
      }
    },
    "purchase.unlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access unlocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整版已解锁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全版を購入済み"
          }
        }
      }
    },
    "purchase.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for purchase approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待购买批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入の承認を待っています。"
          }
        }
      }
    },
    "purchase.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase cancelled. You can try again anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消，可随时重试。"
