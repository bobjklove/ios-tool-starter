        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。いつでも再試行できます。"
          }
        }
      }
    },
    "purchase.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase unavailable or incomplete. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品不可用或购买未完成，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品を利用できないか、購入が完了していません。再試行してください。"
          }
        }
      }
    },
    "purchase.restored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买已恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元しました。"
          }
